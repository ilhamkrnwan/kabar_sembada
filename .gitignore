# ---------------------------------------------------------------------------
# WordPress core is supplied by the Docker image (see compose.yml).
# Only project code is versioned:
#   wp-content/themes/kabarsembada/, wp-content/plugins/kabarsembada/
#   wp-content/themes/sekeco/, wp-content/plugins/sekeco/ (reference, removed later)
# ---------------------------------------------------------------------------

# WordPress core and local config
/wp-admin/
/wp-includes/
/wp-*.php
/wp-config.php
/index.php
/xmlrpc.php
/license.txt
/readme.html

# Inside wp-content, only the project theme and plugin are tracked.
# Everything else (uploads, upgrades, third-party plugins and themes,
# WordPress stubs) stays local.
/wp-content/*
!/wp-content/themes/
!/wp-content/plugins/
/wp-content/themes/*
!/wp-content/themes/kabarsembada/
!/wp-content/themes/sekeco/
/wp-content/plugins/*
!/wp-content/plugins/kabarsembada/
!/wp-content/plugins/sekeco/

# Old site database dumps
*.sql
*.sql.gz

# Local database volume
.db/

# Dependencies and build tooling
node_modules/
vendor/

# Agent tooling (project rules live in AGENTS.md)
.agents
.claude
CLAUDE.md
skills-lock.json

# OS and logs
.DS_Store
Thumbs.db
*.log
