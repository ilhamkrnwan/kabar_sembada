{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kabarsembada/ticker",
  "version": "0.1.0",
  "title": "Ticker Terkini",
  "category": "kabarsembada",
  "icon": "megaphone",
  "description": "Judul berita terbaru yang berjalan, dengan tombol jeda.",
  "keywords": [
    "ticker",
    "terkini",
    "breaking"
  ],
  "textdomain": "kabarsembada",
  "attributes": {
    "label": {
      "type": "string",
      "default": "Terkini"
    },
    "number": {
      "type": "number",
      "default": 6
    },
    "category": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}